<?xml version="1.0" encoding="utf-8"?>
<!-- No plain-HTTP traffic at all. Only the system's trusted certificate authorities. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
